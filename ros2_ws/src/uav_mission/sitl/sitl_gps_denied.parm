# SITL stand-in for the real Cube: no GPS, external nav (SITL vicon) on source set 1, real-drone modes/switches
GPS1_TYPE 0
VISO_TYPE 1
SERIAL5_PROTOCOL 2
EK3_SRC1_POSXY 6
EK3_SRC1_VELXY 6
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 6
EK3_SRC1_YAW 6
RTL_ALT 300
FLTMODE_CH 9
FLTMODE1 0
FLTMODE2 2
FLTMODE3 5
FLTMODE4 9
FLTMODE5 0
FLTMODE6 0
RC5_OPTION 153
RC10_OPTION 90
LAND_SPEED 50
# Same telemetry stream rates as the real Cube (SERIAL0), so MAVROS gets RC channels
SR0_POSITION 10
SR0_EXTRA1 10
SR0_EXT_STAT 2
SR0_RC_CHAN 5
SR0_EXTRA2 2
SR0_EXTRA3 2
